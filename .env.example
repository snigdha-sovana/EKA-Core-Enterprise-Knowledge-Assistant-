# =============================================================================
# Enterprise Knowledge Assistant (EKA) — Environment Configuration
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Local CPU-friendly default for development. Install Ollama, then run:
#   ollama pull qwen2.5:1.5b
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen2.5:1.5b

# Groq Cloud API (Free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.1-70b-versatile

# Ollama local generation (keeps prompts and retrieved documents on this machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:1.5b

# ── Local Embeddings ─────────────────────────────────────────────────────────
RAG_EMBEDDING_PROVIDER=local
# Lightweight multilingual embeddings suited to CPU-only development.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
POSTGRES_USER=eka_user
POSTGRES_PASSWORD=eka_secure_pass_change_in_prod
POSTGRES_DB=eka_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://eka_user:eka_secure_pass_change_in_prod@localhost:5432/eka_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis (Caching & Task Queues) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
TENANT_CACHE_TTL_SECONDS=60

# ── Celery Background Tasks ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vector Store (ChromaDB) ──────────────────────────────────────────────────
RAG_DATA_DIR=data
RAG_CHROMA_PATH=data/chroma_db
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8000

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=eka-auth
JWT_AUDIENCE=eka-api
SUPERADMIN_AUDIENCE=eka-superadmin

# ── Multi-Tenancy Limits ─────────────────────────────────────────────────────
EKA_MAX_DOCS_PER_TENANT=100
EKA_DOC_CAP_WARN_THRESHOLD=80

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_VIEWER=60/minute
RATE_LIMIT_CURATOR=120/minute

# ── Retrieval & Reranker ─────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K_RETRIEVAL=20
RAG_TOP_K_RERANK=5
RAG_TOP_K_FINAL=5
RAG_HYBRID_ALPHA=0.6
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_FAITHFULNESS_THRESHOLD=0.7

# ── CORS ─────────────────────────────────────────────────────────────────────
RAG_CORS_ORIGINS=*
